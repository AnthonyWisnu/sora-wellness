{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "ts-node -r dotenv/config src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node -r dotenv/config dist/src/main.js",
    "lint": "eslint src scripts test",
    "test": "npm run build && node --test dist/test/*.test.js",
    "migrate": "ts-node -r dotenv/config scripts/migrate.ts",
    "seed": "ts-node -r dotenv/config scripts/seed.ts",
    "demo:setup": "ts-node -r dotenv/config scripts/demo-setup.ts",
    "demo:refresh-schedule": "ts-node -r dotenv/config scripts/demo-refresh-schedule.ts",
    "smoke": "ts-node -r dotenv/config scripts/smoke.ts",
    "check:midtrans": "ts-node -r dotenv/config scripts/check-midtrans.ts",
    "import:midtrans": "ts-node -r dotenv/config scripts/import-midtrans-settings.ts",
    "smoke:payments": "ts-node -r dotenv/config scripts/payment-state-smoke.ts",
    "smoke:cancellations": "ts-node -r dotenv/config scripts/cancellation-smoke.ts",
    "smoke:packages": "ts-node -r dotenv/config scripts/package-state-smoke.ts",
    "smoke:health": "ts-node -r dotenv/config scripts/health-attendance-smoke.ts",
    "smoke:content-lockers": "ts-node -r dotenv/config scripts/content-lockers-smoke.ts",
    "smoke:admin-finance": "ts-node -r dotenv/config scripts/admin-finance-smoke.ts",
    "smoke:site": "ts-node -r dotenv/config scripts/site-cms-smoke.ts"
  },
  "license": "UNLICENSED",
  "description": "API satu studio wellness",
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-sync": "^4.2.1",
    "dotenv": "^18.0.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.1"
  }
}
